# Banco de dados. SQLite em memória é usado automaticamente nos testes.
DATABASE_URL=postgresql+psycopg://ukode:ukode@localhost:5432/ukode_core

# Provedor de LLM
ANTHROPIC_API_KEY=

# JWT / identidade (OIDC do tenant do cliente, ou Keycloak no lab)
OIDC_ISSUER=
OIDC_AUDIENCE=

# Notificação de aprovação (humano no circuito)
APPROVAL_WEBHOOK_URL=

# Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=
